            "<Struct 'NiagaraModuleInfo_Custom' (0x000001F5836EE880) {module_name: \"MissileTrailOrigin\", module_type: \"ParticleUpdate\", script_asset_path: \"/Game/GuLiStrike/FX/WM01Missiles/NS_WM01MissileCluster_PreviewLite.NS_WM01MissileCluster_PreviewLite:History_1.NiagaraScratchPadContainer_0.MissileTrailOrigin\", module_index: 5, is_enabled: True, inputs: }>",
            "<Struct 'NiagaraModuleInfo_Custom' (0x000001F5836E1DB0) {module_name: \"MissileRealHistory\", module_type: \"ParticleUpdate\", script_asset_path: \"/Game/GuLiStrike/FX/WM01Missiles/NS_WM01MissileCluster_PreviewLite.NS_WM01MissileCluster_PreviewLite:History_1.NiagaraScratchPadContainer_0.MissileRealHistory\", module_index: 6, is_enabled: True, inputs: }>"
          ],
          "hlsl": {
            "InitializeMissileSlot": "Slot=ExecIndex(); Life=1e9; Position=float3(0,0,0); Velocity=float3(0,0,0); Size=float2(0,0); Color=float4(0,0,0,0); Rotation=0;Slot=ExecIndex()/8; Lane=ExecIndex()%8; Start=Position; End=Position; Sample=Position; Born=-10000; Generation=-1; Bucket=-1; Time=-10000; State=0;",
            "IllustrativePreviewPath": "// Editor-only illustrative trajectories. The registered combat assets use the\n// authoritative CPU/client trajectory via arrays; these preview copies do not.\n// Leave 0.8 seconds after the 2.4 s flight + 2.4 s tail before reusing slots.\nfloat t=fmod(Age,5.6);\nfloat a=saturate(t/2.4);\nfloat s=sin(a*3.14159265),c=cos(a*3.14159265);\nPositionOut=float3(2200*a,(Slot-1.5)*175+sin(a*6+Slot)*160*s,\n    120+s*(430+Slot*100)+sin(a*8+Slot)*70*s);\nDirectionOut=normalize(float3(2200,160*(6*cos(a*6+Slot)*s+3.14159265*sin(a*6+Slot)*c),\n    3.14159265*c*(430+Slot*100)+70*(8*cos(a*8+Slot)*s+3.14159265*sin(a*8+Slot)*c)));\nSizeOut=float2(21,195);\nMetaOut=Slot<4 ? float4(floor(Age/5.6)*64+Slot+7,t<2.4?1:2,2.4,2.4) : float4(0,0,0,2.4);\nTimeOut=Age;\n",
            "MissileTrailOrigin": "PositionOut=Head-Direction*(Size.y*.4923+42); WidthOut=Size.x;",
            "MissileRealHistory": "// Each GPU lane owns a historical world-space segment. Generation changes reset\n// only the reusable live slot; retired quality batches hold immutable array snapshots.\nStartOut=SavedStart; EndOut=SavedEnd; BornOut=Born;\nSampleOut=SavedSample; GenerationOut=SeenGeneration; BucketOut=SeenBucket;\nfloat state=(EmitHistory<.5 && Meta.g>.5) ? 2 : Meta.g;\nTimeOut=Now; StateOut=state;\nfloat lifetime=max(Meta.a,.05);\n// One existing lane bridges the latest sample to the live exhaust origin.\n// The other lanes span the full lifetime without increasing particle capacity.\nfloat interval=lifetime/(8-1);\nint bucket=(int)floor(Now/interval);\nbool reset=abs(Meta.r-SeenGeneration)>.5 || state<.5 || Now<LastTime || Now-LastTime>.20 || distance(Head,SavedSample)>600;\nif(reset)\n{\n    StartOut=Head; EndOut=Head; SampleOut=Head; BornOut=-10000;\n    GenerationOut=Meta.r; BucketOut=bucket;\n}\nelse if((state<1.5 && bucket>SeenBucket) || (state>1.5 && SeenState<1.5))\n{\n    // Use the next lane when an impact falls inside the current bucket: preserve\n    // the preceding full segment instead of overwriting it with the final stub.\n    int writeBucket=max(bucket,SeenBucket+1);\n    if(writeBucket%8==Lane)\n    {\n        StartOut=SavedSample; EndOut=Head; BornOut=Now;\n    }\n    SampleOut=Head; BucketOut=writeBucket;\n}\nif(!reset && state>.5 && state<1.5 && (BucketOut+1)%8==Lane)\n{\n    StartOut=SampleOut; EndOut=Head; BornOut=Now;\n}\nfloat age=max(0,Now-BornOut);\nfloat life=saturate(1-age/lifetime);\nfloat3 delta=EndOut-StartOut;\nfloat segment=length(delta);\n// Smooth low-frequency world-space drift, bounded to <27 cm over 2.4 seconds.\n// Both endpoints use the same field so adjacent narrow segments remain coherent.\nfloat3 midpoint=(StartOut+EndOut)*.5;\nfloat3 drift=float3(sin(midpoint.y*.002+Meta.r*.13),cos(midpoint.x*.002+Meta.r*.13),.55)*min(age,2.4)*7.4;\nPositionOut=midpoint+drift;\nAlignmentOut=segment>.01 ? delta/segment : float3(1,0,0);\nfloat width=min(33,Width*(1+.55*saturate(age/lifetime)));\nSizeOut=(life>0 && segment>.01 && !reset) ? float2(width,segment+width*.12) : float2(0,0);\n// A brief warm origin gives way to dense charcoal smoke, never an emissive ribbon.\nfloat heat=1-smoothstep(0,.08,age);\nColorOut=float4(lerp(float3(.055,.060,.065),float3(1.15,.62,.27),heat),.70*pow(life,1.25)*saturate(TrailWeight));\n"
          }
        }
      ]
    },
