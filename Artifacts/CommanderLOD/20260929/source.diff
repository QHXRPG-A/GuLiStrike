+{
+	// Include displaced geometry, history and any retiring presentation here.
+	FBox Bounds = FBox(ForceInit);
+	TOptional<EGuLiCommanderLODLevel> CurrentLevel;
+	double LastChangeWorldSeconds = -1;
+};
