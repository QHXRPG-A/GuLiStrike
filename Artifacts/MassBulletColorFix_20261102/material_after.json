    {
      "id": "MaterialExpressionCustom_000001CF3F96CA80",
      "class": "Custom",
      "class_full": "MaterialExpressionCustom",
      "pos_x": -200,
      "pos_y": 0,
      "properties": {
        "Code": "\nfloat along = StartDistance + (1.0-saturate(UV.y))*Length;\nfloat age = max(0.0,HeadDistance-along)/max(Speed,1.0)+max(EndAge,0.0);\nfloat life = 1.0-smoothstep(Hold,Hold+max(Fade,0.01),age);\nfloat curve = Bend*sin(6.2831853*along/max(WaveLength,100.0))*smoothstep(0.0,100.0,along);\nfloat d = abs((UV.x-0.5)*Canvas-curve);\nfloat aa = max(fwidth(d),0.12);\nfloat radius = Width*0.5*lerp(0.35,1.0,life);\nfloat body = 1.0-smoothstep(radius-aa,radius+aa,d);\nfloat core = 1.0-smoothstep(radius*0.24-aa,radius*0.24+aa,d);\nfloat halo = exp(-pow(d/max(radius*1.5,0.1),2.0)*3.0)*0.13;\nfloat edge = smoothstep(0.0,4.0,HeadDistance-along)*smoothstep(0.0,12.0,along);\nfloat3 rgb = Emission*(Tint.rgb*(body+halo)+lerp(Tint.rgb,CoreColor.rgb,0.45)*core*0.45);\nreturn float4(rgb,saturate(body+halo)*life*edge*Tint.a*step(0.01,Length));\n",
        "OutputType": "CMOT_Float4",
        "Description": "Fixed world-space curve; per-point age; bounded visible window; no textures",
        "Inputs": "((InputName=\"UV\",Input=(Expression=\"/Script/Engine.MaterialExpressionTextureCoordinate'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionTextureCoordinate_0'\")),(InputName=\"Tint\",Input=(Expression=\"/Script/Engine.MaterialExpressionParticleColor'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionParticleColor_0'\",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1)),(InputName=\"CoreColor\",Input=(Expression=\"/Script/Engine.MaterialExpressionVectorParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionVectorParameter_0'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"StartDistance\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_0'\",Mask=1,MaskR=1)),(InputName=\"HeadDistance\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_0'\",OutputIndex=1,Mask=1,MaskG=1)),(InputName=\"EndAge\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_0'\",OutputIndex=2,Mask=1,MaskB=1)),(InputName=\"Speed\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_0'\",OutputIndex=3,Mask=1,MaskA=1)),(InputName=\"Width\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_1'\",Mask=1,MaskR=1)),(InputName=\"Bend\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_1'\",OutputIndex=1,Mask=1,MaskG=1)),(InputName=\"Hold\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_1'\",OutputIndex=2,Mask=1,MaskB=1)),(InputName=\"Fade\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_1'\",OutputIndex=3,Mask=1,MaskA=1)),(InputName=\"WaveLength\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_2'\",Mask=1,MaskR=1)),(InputName=\"Canvas\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_2'\",OutputIndex=1,Mask=1,MaskG=1)),(InputName=\"Length\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_2'\",OutputIndex=2,Mask=1,MaskB=1)),(InputName=\"Emission\",Input=(Expression=\"/Script/Engine.MaterialExpressionDynamicParameter'/Game/GuLiStrike/FX/BulletTrails/Review_A1/M_MassBulletTrail.M_MassBulletTrail:MaterialExpressionDynamicParameter_2'\",OutputIndex=3,Mask=1,MaskA=1)))",
        "ShowCode": "False"
      },
      "hlsl_code": "\nfloat along = StartDistance + (1.0-saturate(UV.y))*Length;\nfloat age = max(0.0,HeadDistance-along)/max(Speed,1.0)+max(EndAge,0.0);\nfloat life = 1.0-smoothstep(Hold,Hold+max(Fade,0.01),age);\nfloat curve = Bend*sin(6.2831853*along/max(WaveLength,100.0))*smoothstep(0.0,100.0,along);\nfloat d = abs((UV.x-0.5)*Canvas-curve);\nfloat aa = max(fwidth(d),0.12);\nfloat radius = Width*0.5*lerp(0.35,1.0,life);\nfloat body = 1.0-smoothstep(radius-aa,radius+aa,d);\nfloat core = 1.0-smoothstep(radius*0.24-aa,radius*0.24+aa,d);\nfloat halo = exp(-pow(d/max(radius*1.5,0.1),2.0)*3.0)*0.13;\nfloat edge = smoothstep(0.0,4.0,HeadDistance-along)*smoothstep(0.0,12.0,along);\nfloat3 rgb = Emission*(Tint.rgb*(body+halo)+lerp(Tint.rgb,CoreColor.rgb,0.45)*core*0.45);\nreturn float4(rgb,saturate(body+halo)*life*edge*Tint.a*step(0.01,Length));\n",
      "output_type": "CMOT_Float4",
      "custom_input_names": "UV,Tint,CoreColor,StartDistance,HeadDistance,EndAge,Speed,Width,Bend,Hold,Fade,WaveLength,Canvas,Length,Emission",
