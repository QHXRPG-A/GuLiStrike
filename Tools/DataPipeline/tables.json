{
  "excel": "Data/Excel/GuLiStrikeShip.xlsx",
  "sheets": {
    "Parts": {
      "struct": "/Script/GuLiStrike.GuLiStrikeShipPartRow",
      "assign_to": "part_data_table",
      "row_name": "PartId",
      "schema": {
        "PartId": ["str", null, null],
        "Type": ["aux", ["Engine", "Weapon"], null],
        "PartDisplayName": ["str", null, null, "DisplayName"],
        "PartMass": ["num", 0, null],
        "Thrust": ["num", 0, null],
        "Damage": ["num", 0, null],
        "FireRate": ["num", 0.01, null],
        "MuzzleOffset": ["vector", null, null, "Muzzle"],
        "ProjectileClass": ["str", null, null],
        "备注": ["any", null, null]
      },
      "required": ["PartId", "Type", "PartDisplayName", "PartMass"],
      "required_by": {
        "Type": {
          "Engine": ["Thrust"],
          "Weapon": ["Damage", "FireRate", "ProjectileClass"]
        }
      }
    },
    "Tuning": {
      "struct": "/Script/GuLiStrike.GuLiStrikeShipTuningRow",
      "assign_to": "tuning_data_table",
      "row_name": "Preset",
      "schema": {
        "Preset": ["str", null, null],
        "HullMass": ["num", 1, null],
        "BaseMaxSpeed": ["num", 0, null],
        "BaseAcceleration": ["num", 0, null],
        "NominalThrustRatio": ["num", 0.01, null],
        "SpeedMultiplierMin": ["num", 0.1, null],
        "SpeedMultiplierMax": ["num", 1, null],
        "BoostThrustMultiplier": ["num", 1, null],
        "MousePitchScale": ["num", null, null],
        "MouseYawScale": ["num", null, null],
        "YawRate": ["num", 0, null],
        "YawResponseSpeed": ["num", 0.1, null],
        "YawStopDamping": ["num", 0.05, null],
        "MaxBankAngle": ["num", 0, 45],
        "BankInterpSpeed": ["num", 0.1, null],
        "OrientTurnSpeed": ["num", 0.1, null],
        "OrientToMovement": ["bool", null, null],
        "OrientMinForwardDot": ["num", -1, 1],
        "CameraPitchMin": ["num", null, null],
        "CameraPitchMax": ["num", null, null],
        "HullMeshOffset": ["vector", null, null],
        "备注": ["any", null, null]
      },
      "required": [
        "Preset", "HullMass", "BaseMaxSpeed", "BaseAcceleration", "NominalThrustRatio",
        "SpeedMultiplierMin", "SpeedMultiplierMax", "BoostThrustMultiplier",
        "MousePitchScale", "MouseYawScale", "YawRate", "YawResponseSpeed", "YawStopDamping",
        "MaxBankAngle", "BankInterpSpeed", "OrientTurnSpeed", "OrientToMovement",
        "OrientMinForwardDot", "CameraPitchMin", "CameraPitchMax", "HullMeshOffset"
      ],
      "compare": [
        { "col": "SpeedMultiplierMax", "op": ">=", "other": "SpeedMultiplierMin" },
        { "col": "CameraPitchMax", "op": ">", "other": "CameraPitchMin" }
      ]
    }
  }
}
