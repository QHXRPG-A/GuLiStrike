+void GuLiUnitRenderPolicy::ApplyToActor(AActor* Actor)
+{
+	if (!Actor) return;
+	TInlineComponentArray<UMeshComponent*> Meshes;
+	Actor->GetComponents(Meshes, true);
+	for (UMeshComponent* Mesh : Meshes) Apply(*Mesh);
+}
