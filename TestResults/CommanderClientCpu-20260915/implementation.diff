+	for (const auto Id : SelectedSoldiers) if (!Next.Contains(Id)) DirtyRingColorIds.Add(Id);
+	for (const auto Id : Next) if (!SelectedSoldiers.Contains(Id)) DirtyRingColorIds.Add(Id);
+	SelectedSoldiers = MoveTemp(Next);
