+void AGuLiCommanderPresentationActor::RebuildPredictionObstacles(const AGuLiSoldierStateReplicator& Replicator)
+{
+	PredictionObstacles.Reset(); PredictionObstacleCells.Reset();
+	PredictionMaximumRadius = PredictionMaximumGap = 0;
+	if (PredictedMoves.IsEmpty()) return;
+	auto Add = [this](const FGuLiUnitOccupant& Body)
+	{
+		if (!Body.Key || !Body.Footprint.IsValid()) return;
+		PredictionObstacles.Add(Body.Key, Body);
+		PredictionObstacleCells.FindOrAdd(FIntPoint(FMath::FloorToInt(Body.Location.X / GuLiUnitSpacing::GridCellSize),
+			FMath::FloorToInt(Body.Location.Y / GuLiUnitSpacing::GridCellSize))).Add(Body.Key);
+		PredictionMaximumRadius = FMath::Max(PredictionMaximumRadius, Body.Footprint.Radius);
+		PredictionMaximumGap = FMath::Max(PredictionMaximumGap, Body.Footprint.MinGap);
+	};
+	const auto* Data = GetWorld()->GetSubsystem<UGuLiCommanderDataSubsystem>();
+	for (const auto& State : Replicator.GetItems())
+	{
+		const auto* Soldier = PresentedSoldiers.Find(State.SoldierId);
+		const auto* Definition = Data ? Data->FindSoldierDefinition(State.UnitTypeId) : nullptr;
+		if (!State.IsAlive() || State.bPhased || !Soldier || !Soldier->bHasAuthoritativeTransform || !Definition) continue;
+		FGuLiUnitOccupant Body; Body.Key = State.SoldierId.Value; Body.Footprint = Definition->GetFootprint();
+		Body.Location = (Soldier->bHasPresentedTransform ? Soldier->PresentedTransform : Soldier->AuthoritativeTransform).GetLocation();
+		Add(Body);
+	}
+	for (TActorIterator<ACharacter> It(GetWorld()); It; ++It)
+	{
+		const auto* Movement = It->FindComponentByClass<UGuLiExternalCharacterMovementComponent>();
+		const auto* Health = It->FindComponentByClass<UGuLiCombatHealthComponent>();
+		if (Movement && (!Health || Health->IsAlive()) && !UGuLiExternalUnitControlComponent::IsActorPhased(*It)) Add(Movement->MakeUnitOccupant());
+	}
+}
+
+FVector AGuLiCommanderPresentationActor::ConstrainPredictionOffset(const FGuLiSoldierId Id, const FVector& Location, const FVector& Offset)
+{
+	const auto* Cached = PredictionObstacles.Find(Id.Value);
+	if (!Cached || Offset.IsNearlyZero()) return Offset;
+	auto Body = *Cached; Body.Location = Location;
+	// The table is built once per render frame. Cover both the previous displayed offset
+	// and this frame's possible prediction, without a global client movement solver.
+	const double Reach = Body.Footprint.Radius + PredictionMaximumRadius + FMath::Max(Body.Footprint.MinGap, PredictionMaximumGap)
+		+ GuLiUnitSpacing::SafetyMargin + MaximumPredictionDistanceCentimeters * 2;
+	const FVector End = Location + Offset;
+	const FIntPoint Min(FMath::FloorToInt((FMath::Min(Location.X, End.X) - Reach) / GuLiUnitSpacing::GridCellSize),
+		FMath::FloorToInt((FMath::Min(Location.Y, End.Y) - Reach) / GuLiUnitSpacing::GridCellSize));
+	const FIntPoint Max(FMath::FloorToInt((FMath::Max(Location.X, End.X) + Reach) / GuLiUnitSpacing::GridCellSize),
+		FMath::FloorToInt((FMath::Max(Location.Y, End.Y) + Reach) / GuLiUnitSpacing::GridCellSize));
+	float Fraction = 1;
+	for (int32 X = Min.X; X <= Max.X; ++X) for (int32 Y = Min.Y; Y <= Max.Y; ++Y)
+		if (const auto* Cell = PredictionObstacleCells.Find(FIntPoint(X,Y)))
+			for (const uint64 Key : *Cell)
+			{
+				if (Key == Id.Value) continue;
+				float Time; FVector Normal;
+				if (GuLiUnitSpacing::Contact(Body, Offset, PredictionObstacles.FindChecked(Key), FVector::ZeroVector, Time, Normal))
+					Fraction = FMath::Min(Fraction, FMath::Max(0.f, Time - .001f));
+			}
+	const FVector Allowed = Offset * Fraction;
+	PredictionObstacles.FindChecked(Id.Value).Location = Location + Allowed;
+	return Allowed;
+}
