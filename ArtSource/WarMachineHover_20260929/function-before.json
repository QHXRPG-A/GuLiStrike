    {
      "id": "MaterialExpressionCustom_000002B1A16D80C0",
      "class": "Custom",
      "class_full": "MaterialExpressionCustom",
      "pos_x": 0,
      "pos_y": 0,
      "properties": {
        "Code": "// Embedded in MF_GuLiRigidMechanical by build_mass_rigid_materials.py.\n// UV1 = pivot.xy, UV2 = pivot.z/part; all distances are authored mesh cm.\n// Pose 0..10 matches GuLiMechanicalAnimation::BuildFrame. UE pitch is +X -> +Z.\nstruct RigidMath\n{\n    float3 Pitch(float3 v, float a) { float s,c; sincos(a,s,c); return float3(c*v.x-s*v.z,v.y,s*v.x+c*v.z); }\n    float3 Yaw(float3 v, float a) { float s,c; sincos(a,s,c); return float3(c*v.x-s*v.y,s*v.x+c*v.y,v.z); }\n    float3 Axis(float3 v, float3 axis, float a) { float s,c; sincos(a,s,c); return v*c+cross(axis,v)*s+axis*dot(axis,v)*(1-c); }\n};\nRigidMath r;\nfloat3 p = Position;\nfloat3 n = LocalNormal;\nfloat3 pivot = float3(PivotXY, PivotZPart.x);\nint part = (int)round(PivotZPart.y);\nif (Kind > 0.5 && Kind < 1.5)\n{\n    if (part == 4 || part == 5) p.x -= part == 4 ? V3 : V4;\n    if (part >= 2 && part <= 5)\n    {\n        float pitch = (part == 2 || part == 4) ? V1 : V2;\n        p = pivot + r.Pitch(p-pivot, pitch); n = r.Pitch(n, pitch);\n    }\n    if (part >= 1 && part <= 5)\n    {\n        p = UpperPivot+r.Yaw(p-UpperPivot,V0); n = r.Yaw(n,V0);\n    }\n    if (part >= 6 && part <= 9)\n    {\n        float angle=length(float2(V5,V6));\n        float3 axis=float3(V5,V6,0)/max(angle,0.000001);\n        p=pivot+r.Axis(p-pivot,axis,angle); n=r.Axis(n,axis,angle);\n    }\n}\nelse if (Kind >= 1.5)\n{\n    if (part == 2) { p=pivot+r.Pitch(p-pivot,V1); n=r.Pitch(n,V1); }\n    if (part >= 6 && part <= 9)\n    {\n        float angle=part==6?V7:(part==7?V8:(part==8?V9:V10));\n        p=pivot+r.Axis(p-pivot,float3(0,1,0),angle); n=r.Axis(n,float3(0,1,0),angle);\n    }\n}\nAnimatedNormal=normalize(n);\nreturn p-Position;\n",
        "OutputType": "CMOT_Float3",
        "Description": "Custom",
        "Inputs": "((InputName=\"Kind\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionFunctionInput_8'\")),(InputName=\"UpperPivot\",Input=(Expression=\"/Script/Engine.MaterialExpressionFunctionInput'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionFunctionInput_9'\")),(InputName=\"Position\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreSkinnedPosition'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreSkinnedPosition_4'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"LocalNormal\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreSkinnedNormal'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreSkinnedNormal_4'\",Mask=1,MaskR=1,MaskG=1,MaskB=1)),(InputName=\"PivotXY\",Input=(Expression=\"/Script/Engine.MaterialExpressionTextureCoordinate'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionTextureCoordinate_8'\")),(InputName=\"PivotZPart\",Input=(Expression=\"/Script/Engine.MaterialExpressionTextureCoordinate'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionTextureCoordinate_9'\")),(InputName=\"V0\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_33'\")),(InputName=\"V1\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_34'\")),(InputName=\"V2\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_35'\")),(InputName=\"V3\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_36'\")),(InputName=\"V4\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_37'\")),(InputName=\"V5\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_38'\")),(InputName=\"V6\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_39'\")),(InputName=\"V7\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_40'\")),(InputName=\"V8\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_41'\")),(InputName=\"V9\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_42'\")),(InputName=\"V10\",Input=(Expression=\"/Script/Engine.MaterialExpressionPreviousFrameSwitch'/Game/Commander/Units/MechanicalAnimation/MF_GuLiRigidMechanical.MF_GuLiRigidMechanical:MaterialExpressionPreviousFrameSwitch_43'\")))",
