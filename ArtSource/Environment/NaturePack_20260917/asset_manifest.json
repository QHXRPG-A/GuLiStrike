  "geometry_budget_note": "v3为常规非Nanite植被贴片制作上限，替代v2逐叶/逐瓣几何预算；不是实际Blender、FBX或UE测量值。预算不等同GPU性能。",
  "production": {
    "pipeline": "Atlas -> tightly fitted segmented cards -> custom normals -> vertex wind alpha -> LOD -> FBX -> masked instanced foliage",
    "nanite_default": false,
    "nanite_note": "Baseline is conventional cards + authored LODs for this low-density geometry pack; not a claim that cards always outperform Nanite geometry.",
    "grass": "Cluster silhouettes in atlas; crossed and offset cards, not individual grass-blade geometry.",
    "flowers": "Entire flower-head silhouette in atlas, small bent head card and stem/leaf cards; no separate petal mesh or extruded center.",
    "fern": "Whole pinnate frond in atlas; no individual leaflet mesh.",
    "broadleaf": "Minimal bent leaf cards with close-fitting boundaries; retain necessary silhouette under overhead cameras.",
    "groundcover": "Separated low tilted patches with tight bounds, not stacked full-area transparent carpets.",
    "texture_output": "Production RGBA BaseColor+Opacity plus packed masks; PNG/TGA baked after A. Current SVG is an editable technical shape sample, not a finished production atlas.",
    "texture_constraints": [
      "No baked scene shadows/highlights in base color",
      "Alpha edge color dilation and atlas gutters, mip/alpha coverage inspection",
      "Keep UV islands within tile gutters; no wrap bleed",
      "Normal or authored normals drive three-tone light, not random per-triangle palette",
      "Flower petal mask keeps stems/centers unchanged for N31/N32 tint"
    ],
    "instance_type": "Static Mesh Foliage / FoliageType_InstancedStaticMesh, not one Actor per plant",
    "performance_scope": [
