 void FMCPythonTcpServer::Stop()
 {
 	bShouldRun = false;
+	FCoreDelegates::OnBeginFrame.Remove(BeginFrameHandle);
+	BeginFrameHandle.Reset();
 	TcpListener.Reset();
+	if (PendingCommands)
+	{
+		FScopeLock Guard(&PendingCommands->Lock);
+		PendingCommands->bAccepting = false;
+		FMCPythonPendingCommands::FCommand Command;
+		while (PendingCommands->Queue.Dequeue(Command))
+		{
+			Command.Socket->Close();
+			ISocketSubsystem::Get(PLATFORM_SOCKETSUBSYSTEM)->DestroySocket(Command.Socket);
+		}
+	}
+	PendingCommands.Reset();
 	UE_LOG(LogMCPython, Log, TEXT("TCP server stopped."));
 }
 
+void FMCPythonTcpServer::ProcessPendingCommand()
+{
+    check(IsInGameThread());
+    if (bProcessingCommand || !PendingCommands)
+        return;
+
+    FMCPythonPendingCommands::FCommand Command;
+    {
+        FScopeLock Guard(&PendingCommands->Lock);
+        if (!PendingCommands->Queue.Dequeue(Command))
+            return;
+    }
+
+    // GameThread tasks may run inside UWorld::Tick while it waits for a tick
+    // group. Map loading/GC there can destroy a level still in the tick list.
+    // OnBeginFrame runs before engine/world ticking; execute one command here.
+    TGuardValue<bool> ProcessingGuard(bProcessingCommand, true);
+    ProcessDataOnGameThread(Command.Data, Command.Socket, Command.Endpoint);
+}
